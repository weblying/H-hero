# Copy this file to .env and fill in real values. Never commit .env.
PORT=3000
BASE_URL=http://localhost:3000
# Set to 1 when deployed behind a proxy/load balancer (Render, Railway, Fly, nginx...)
# TRUST_PROXY=1

# Long random secret for the staff page (24+ chars). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=replace-with-a-long-random-secret

# Optional: secret used to sign customer booking links. If unset, one is generated and stored in the database.
# LINK_SECRET=

# Where the SQLite file lives. In production point this at a persistent disk/volume.
# DB_PATH=/var/data/haulhero.sqlite

PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# From PayPal Developer > your app > Webhooks (URL: BASE_URL/api/paypal/webhook, event: PAYMENT.CAPTURE.COMPLETED)
PAYPAL_WEBHOOK_ID=

# Optional email notifications through Resend (https://resend.com). Without these, emails are only logged.
RESEND_API_KEY=
MAIL_FROM=HaulHero <bookings@your-domain.com>
STAFF_EMAIL=

# Shown in the website footer / FAQ (leave blank to hide)
CONTACT_EMAIL=
CONTACT_PHONE=
# e.g. your mover registration / authority numbers, shown in the footer once you have them
LEGAL_LINE=

DEPOSIT_PERCENT=20
BASE_FEE_USD=125
RATE_PER_MILE_USD=2.15
RATE_PER_POUND_USD=0.035
